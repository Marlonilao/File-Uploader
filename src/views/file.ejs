<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= file.name %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>

<body class="page">
  <header class="topbar">
    <span class="topbar__brand">Drive</span>

    <div class="topbar__user">
      <span><%= user.username %></span>
      <form action="/logout" method="POST">
        <button type="submit" class="link-button">Log out</button>
      </form>
    </div>
  </header>

  <main class="drive">
    <nav class="crumbs">
      <a href="/folders/<%= file.folder.id %>">Back to <%= file.folder.name %></a>
    </nav>

    <div class="card">
      <h2 class="card__title"><%= file.name %></h2>

      <dl class="details">
        <div class="details__row">
          <dt>Size</dt>
          <dd><%= file.size %> bytes</dd>
        </div>
        <div class="details__row">
          <dt>Type</dt>
          <dd><%= file.mimeType %></dd>
        </div>
        <div class="details__row">
          <dt>Uploaded</dt>
          <dd><%= file.createdAt.toLocaleString() %></dd>
        </div>
      </dl>

      <div class="actions">
        <a href="/files/<%= file.id %>/download" class="btn btn--link">Download</a>

        <form action="/files/<%= file.id %>/delete" method="POST" onsubmit="return confirm('Delete this file? This cannot be undone.')">
          <button type="submit" class="btn btn--danger">Delete</button>
        </form>
      </div>
    </div>
  </main>
</body>

</html>