<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= folder.name %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>

<body class="page">
  <header class="topbar">
    <span class="topbar__brand">Drive</span>

    <div class="topbar__user">
      <span><%= user.username %></span>
      <a class="link-button" href="/logout">Log out</a>
    </div>
  </header>

  <main class="drive">
    <nav class="crumbs">
      <% ancestors.forEach(function (crumb) { %>
      <a href="/folders/<%= crumb.id %>"><%= crumb.name %></a>
      <span class="crumbs__sep">/</span>
      <% }); %>
      <span class="crumbs__current"><%= folder.name %></span>
    </nav>

    <%- include("partials/errors.ejs") %>

    <div class="card">
      <h2 class="card__title">New folder</h2>

      <form action="/folders/<%= folder.id %>/children" method="POST" class="inline-form">
        <div class="field">
          <label for="name">Folder name</label>
          <input type="text" id="name" name="name" required>
        </div>
        <button type="submit" class="btn">Create</button>
      </form>
    </div>

    <div class="card">
      <h2 class="card__title">Upload a file</h2>

      <form action="/folders/<%= folder.id %>/files" method="POST" enctype="multipart/form-data" class="inline-form">
        <div class="field">
          <label for="file">Choose a file</label>
          <input type="file" id="file" name="file" required>
        </div>
        <button type="submit" class="btn">Upload</button>
      </form>
    </div>

    <div class="card">
      <h2 class="card__title">Share this folder</h2>
      <p class="card__note">Anyone with the link can view and download everything inside.</p>

      <form action="/folders/<%= folder.id %>/share" method="POST" class="inline-form">
        <div class="field">
          <label for="duration">Link duration</label>
          <select id="duration" name="duration">
            <option value="1d">1 day</option>
            <option value="10d">10 days</option>
            <option value="30d">30 days</option>
          </select>
        </div>
        <button type="submit" class="btn">Create link</button>
      </form>

      <% if (shareToken) { %>
      <p class="share-link"><%= shareUrl %></p>
      <% } %>
    </div>

    <div class="card">
      <div class="card__header">
        <h2 class="card__title"><%= folder.name %></h2>

        <% if (folder.parentId) { %>
        <form method="post" action="/folders/<%= folder.id %>/delete" onsubmit="return confirm('Delete this folder and everything in it?')">
          <button type="submit" class="btn btn--danger btn--small">Delete folder</button>
        </form>
        <% } %>

        <% if (folder.parentId) { %>
        <form method="post" action="/folders/<%= folder.id %>/rename" class="inline-form">
          <div class="field">
            <label for="rename" class="sr-only">New name</label>
            <input type="text" id="rename" name="name" value="<%= folder.name %>" required>
          </div>
          <button type="submit" class="btn btn--small">Rename</button>
        </form>
        <% } %>
      </div>

      <% if (folders.length === 0 && files.length === 0) { %>
      <p class="empty">This folder is empty.</p>
      <% } else { %>
      <ul class="items">
        <% folders.forEach(function (child) { %>
        <li class="item">
          <a href="/folders/<%= child.id %>" class="item__name"><%= child.name %></a>
          <span class="item__meta">Folder</span>
        </li>
        <% }); %>

        <% files.forEach(function (file) { %>
        <li class="item">
          <a href="/files/<%= file.id %>" class="item__name"><%= file.name %></a>
          <span class="item__meta"><%= file.size %> bytes</span>
        </li>
        <% }); %>
      </ul>
      <% } %>
    </div>
  </main>
</body>